---
import type { Download } from '../lib/product'

interface Props {
  downloads: Download[]
  releases?: string
}

const { downloads, releases } = Astro.props
---

<div class="dl">
  <div class="dl-head" aria-hidden="true">
    <span>file</span>
    <span>说明</span>
    <span>大小</span>
    <span></span>
  </div>

  {downloads.map((row, index) => (
    <div class="dl-row">
      <span class="file">{row.file}</span>
      <span class="label">{row.label}</span>
      <span class="size">{row.size || '—'}</span>
      <a
        class:list={['btn', index === 0 ? 'btn--solid' : 'btn--ghost']}
        href={row.href}
        rel="noopener"
        target="_blank"
        aria-label={`下载 ${row.label}：${row.file}`}
      >
        download
      </a>
    </div>
  ))}

  {releases && (
    <p class="more">
      <span class="dim-2">→</span>
      <a href={releases} rel="noopener" target="_blank">
        releases · 全部资产与更新日志
      </a>
    </p>
  )}
</div>

<style>
  .dl {
    border-top: 1px solid var(--rule);
  }

  .dl-head,
  .dl-row {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) 7ch auto;
    gap: 14px;
    align-items: center;
  }

  .dl-head {
    padding-block: 7px;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--dim-2);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .dl-row {
    padding-block: 11px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .dl-row:hover .label {
    color: var(--fg);
  }

  .file {
    color: var(--amber);
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .label {
    color: var(--dim);
    font-size: 12px;
    transition: color var(--dur) var(--ease);
  }

  .size {
    color: var(--dim-2);
    font-size: 11px;
    text-align: end;
    white-space: nowrap;
  }

  .more {
    display: flex;
    gap: 8px;
    padding-top: 10px;
    font-size: 11.5px;
  }

  .more a {
    color: var(--dim);
    text-underline-offset: 3px;
    transition: color var(--dur) var(--ease);
  }

  .more a:hover {
    color: var(--green);
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .dl-head {
      display: none;
    }

    .dl-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 12px;
      padding-block: 13px;
    }

    .file {
      grid-column: 1;
    }

    .size {
      grid-column: 1;
      text-align: start;
    }

    .label {
      grid-column: 1;
      grid-row: 2;
      color: var(--dim-2);
    }

    .size {
      grid-row: 2;
      justify-self: end;
    }

    .btn {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
    }
  }
</style>
