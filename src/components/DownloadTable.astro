---
import type { Download } from '../data/products'

interface Props {
  downloads: Download[]
  releases: string
}

const { downloads, releases } = Astro.props
---

<ul class="downloads">
  {downloads.map((item) => (
    <li class="download">
      <div class="download-info">
        <p class="download-label">{item.label}</p>
        <p class="download-note mono">{item.note}</p>
      </div>
      <a class="btn" href={item.href} rel="noopener" target="_blank">下载</a>
    </li>
  ))}
</ul>

<p class="download-all">
  <a href={releases} rel="noopener" target="_blank">在 GitHub Releases 查看全部资产与更新日志 →</a>
</p>

<style>
  .downloads {
    display: grid;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .download {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
  }

  .download-info {
    display: grid;
    gap: 3px;
  }

  .download-label {
    font-size: 0.9375rem;
    font-weight: 560;
  }

  .download-note {
    color: var(--faint);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .download .btn {
    min-height: 38px;
    padding-inline: 16px;
    font-size: 0.875rem;
  }

  .download-all {
    margin-top: 18px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .download-all a {
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 2px;
  }

  .download-all a:hover {
    color: var(--accent);
  }
</style>
