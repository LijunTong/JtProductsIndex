---
import type { Download } from '../data/products'

interface Props {
  downloads: Download[]
  releases: string
}

const { downloads, releases } = Astro.props
---

<ul class="downloads">
  {downloads.map((item) => (
    <li class="download">
      <div>
        <p class="download-label">{item.label}</p>
        <p class="download-note mono">{item.note}</p>
      </div>
      <a class="btn" href={item.href} rel="noopener" target="_blank">下载</a>
    </li>
  ))}
</ul>

<p class="download-all">
  <a href={releases} rel="noopener" target="_blank">在 GitHub Releases 查看全部资产与更新日志 →</a>
</p>

<style>
  .downloads {
    display: grid;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .download {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .download-label {
    font-weight: 600;
  }

  .download-note {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .download-all {
    margin-top: var(--space-4);
    font-size: var(--step--1);
  }

  .download-all a {
    color: var(--muted);
  }

  .download-all a:hover {
    color: var(--accent);
  }
</style>
