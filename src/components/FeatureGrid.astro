---
import type { Feature } from '../data/products'

interface Props {
  features: Feature[]
  columns?: 2 | 3
}

const { features, columns = 2 } = Astro.props
---

<ul class:list={['features', `cols-${columns}`]}>
  {features.map((feature, index) => (
    <li class="feature">
      <span class="index mono">{String(index + 1).padStart(2, '0')}</span>
      <h3>
        {feature.title}
        {feature.tag && <span class="tag mono">{feature.tag}</span>}
      </h3>
      <p>{feature.body}</p>
    </li>
  ))}
</ul>

<style>
  .features {
    display: grid;
    align-items: stretch;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .feature {
    display: grid;
    gap: 6px;
    padding-block: clamp(20px, 2.4vw, 28px);
    border-bottom: 1px solid var(--border);
  }

  .index {
    color: var(--faint);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font-size: 1.0625rem;
    font-weight: 560;
    letter-spacing: -0.01em;
  }

  .tag {
    color: var(--faint);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  p {
    max-width: 46ch;
    color: var(--muted);
    font-size: 0.9063rem;
    line-height: 1.68;
  }

  @media (min-width: 720px) {
    .cols-2,
    .cols-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      column-gap: clamp(32px, 4vw, 56px);
    }
  }

  @media (min-width: 1000px) {
    .cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
