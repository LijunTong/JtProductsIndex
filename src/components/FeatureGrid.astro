---
import type { Feature } from '../data/products'

interface Props {
  features: Feature[]
  columns?: 2 | 3
}

const { features, columns = 2 } = Astro.props
---

<ul class:list={['features', `cols-${columns}`]}>
  {features.map((feature) => (
    <li class="feature">
      <div class="feature-head">
        <h3>{feature.title}</h3>
        {feature.tag && <span class="tag">{feature.tag}</span>}
      </div>
      <p>{feature.body}</p>
    </li>
  ))}
</ul>

<style>
  .features {
    display: grid;
    gap: 12px;
    list-style: none;
  }

  .feature {
    display: grid;
    align-content: start;
    gap: 9px;
    min-height: 148px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur var(--ease));
  }

  .feature:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .feature-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  h3 {
    font-size: 1rem;
    line-height: 1.35;
  }

  p {
    max-width: 54ch;
    color: var(--muted);
    font-size: 0.9063rem;
    line-height: 1.7;
  }

  @media (min-width: 720px) {
    .cols-2,
    .cols-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1060px) {
    .cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
