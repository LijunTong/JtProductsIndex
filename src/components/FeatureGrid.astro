---
import type { Feature } from '../lib/product'

interface Props {
  features: Feature[]
}

const { features } = Astro.props
---

<ul class="feats">
  {features.map((feature) => (
    <li class="feat">
      <h3>
        <span class="plus" aria-hidden="true">+</span>
        {feature.title}
        {feature.tag && <span class="tag">{feature.tag}</span>}
      </h3>
      <p>{feature.body}</p>
    </li>
  ))}
</ul>

<style>
  .feats {
    display: grid;
    gap: 0 40px;
  }

  .feat {
    padding-block: 14px 16px;
    border-top: 1px solid var(--rule-soft);
  }

  .feat:first-child,
  .feat:nth-child(2) {
    border-top: 1px solid var(--rule);
  }

  h3 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 5px;
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .plus {
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
  }

  .tag {
    padding: 1px 6px;
    border: 1px solid var(--rule);
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    line-height: 1.6;
  }

  p {
    max-width: 46ch;
    color: var(--dim);
    font-size: 12.5px;
    line-height: 1.75;
  }

  @media (min-width: 760px) {
    .feats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feat:nth-child(2) {
      border-top: 1px solid var(--rule);
    }
  }
</style>
