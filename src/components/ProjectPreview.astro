---
import { Image } from 'astro:assets'
import type { Product, Shot } from '../data/products'

interface Props {
  product: Product
  cover: Shot
  loading?: 'eager' | 'lazy'
  sizes?: string
  widths?: number[]
}

const {
  product,
  cover,
  loading = 'lazy',
  sizes = '(min-width: 1040px) 760px, 94vw',
  widths = [640, 960, 1440],
} = Astro.props
---

<figure
  class:list={['preview', `preview--${product.preview}`]}
  data-tone={product.tone}
>
  {product.preview === 'desktop' && (
    <div class="preview-bar preview-bar--desktop" aria-hidden="true">
      <span class="preview-mark"></span>
      <span class="preview-name">{product.englishName}</span>
      <span class="preview-version">v{product.version}</span>
    </div>
  )}

  {product.preview === 'browser' && (
    <div class="preview-bar preview-bar--browser" aria-hidden="true">
      <span class="browser-address">
        <span class="preview-mark"></span>
        {product.englishName}
      </span>
      <span class="preview-version">v{product.version}</span>
    </div>
  )}

  {product.preview === 'code' && (
    <div class="preview-bar preview-bar--code" aria-hidden="true">
      <span class="code-prompt">&gt;_</span>
      <span class="preview-name">{product.englishName}</span>
      <span class="preview-version">v{product.version}</span>
    </div>
  )}

  <div class:list={['preview-media', `preview-media--${product.preview}`]}>
    {product.preview === 'phone' ? (
      <div class="preview-phone-frame">
        <Image
          src={cover.src}
          alt={cover.alt}
          widths={widths}
          sizes={sizes}
          loading={loading}
          format="webp"
          quality={84}
        />
      </div>
    ) : (
      <Image
        src={cover.src}
        alt={cover.alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        format="webp"
        quality={84}
      />
    )}
  </div>

  <figcaption>
    <span>{cover.caption}</span>
    <span class="preview-platforms">{product.platforms.join(' · ')}</span>
  </figcaption>
</figure>

<style>
  .preview {
    width: 100%;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--project-surface);
    box-shadow: var(--shadow);
  }

  .preview-bar {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 88%, var(--project-soft));
  }

  .preview-mark {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--project-accent);
  }

  .preview-name {
    min-width: 0;
    overflow: hidden;
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview-version {
    margin-inline-start: auto;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
  }

  .preview-bar--browser {
    min-height: 40px;
    padding: 7px 10px;
  }

  .browser-address {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 8px;
    min-width: 0;
    min-height: 26px;
    padding: 0 9px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview-bar--code {
    border-color: #2c3540;
    background: #1b222b;
  }

  .code-prompt {
    color: #7dd3b0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .preview-bar--code .preview-name {
    color: #dbe5ef;
  }

  .preview-bar--code .preview-version {
    color: #91a0af;
  }

  .preview-media {
    min-width: 0;
    overflow: hidden;
    background: var(--project-surface);
  }

  .preview-media img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    min-width: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .preview-platforms {
    flex: none;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .preview--phone .preview-media {
    padding: 22px 24px 0;
    background: var(--project-soft);
  }

  .preview-phone-frame {
    width: min(100%, 320px);
    margin-inline: auto;
    padding: 9px 9px 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-bottom: 0;
    border-radius: 24px 24px 0 0;
    background: var(--surface);
  }

  .preview-phone-frame img {
    display: block;
    width: 100%;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
  }

  .preview--code {
    background: #151b22;
  }

  .preview--image {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  @media (max-width: 620px) {
    figcaption {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .preview-platforms {
      white-space: normal;
    }
  }
</style>
