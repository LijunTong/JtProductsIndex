---
interface Props {
  title: string
  description?: string
  align?: 'start' | 'center'
}

const { title, description, align = 'start' } = Astro.props
---

<header class:list={['section-heading', `is-${align}`]}>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: 10px;
    max-width: 58ch;
  }

  .is-center {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  h2 {
    font-size: var(--step-3);
  }

  p {
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
