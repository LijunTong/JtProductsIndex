---
interface Props {
  eyebrow?: string
  title: string
  description?: string
  align?: 'start' | 'center'
}

const { eyebrow, title, description, align = 'start' } = Astro.props
---

<header class:list={['section-heading', `is-${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="lead">{description}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-3);
    max-width: 58ch;
  }

  .is-center {
    justify-items: center;
    text-align: center;
    margin-inline: auto;
  }

  h2 {
    font-size: var(--step-3);
  }

  .lead {
    font-size: var(--step-0);
  }
</style>
