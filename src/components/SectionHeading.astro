---
interface Props {
  /** 命令字样，例如 `cat features.md` */
  command?: string
  title: string
  description?: string
}

const { command, title, description } = Astro.props
const label = command ?? title
---

<header class="head">
  <h2 class="block">
    {command && <span class="p" aria-hidden="true">$</span>}
    {label}
  </h2>
  {!command && <span class="sr-only">{title}</span>}
  {description && <p class="note"><span class="hash" aria-hidden="true">#</span> {description}</p>}
</header>

<style>
  .head {
    display: grid;
    gap: 2px;
  }

  .block {
    margin: 0;
  }

  .p {
    color: var(--green);
    margin-inline-end: 2px;
  }

  .note {
    max-width: 68ch;
    padding-inline-start: 1.6ch;
    color: var(--dim-2);
    font-size: 11.5px;
    line-height: 1.7;
  }

  .hash {
    color: var(--dim-2);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
