---
import { Image, getImage } from 'astro:assets'
import type { Shot } from '../lib/product'

interface Props {
  shots: Shot[]
  eagerFirst?: boolean
  /** 小于这个数量就不做首图通栏 */
  wideFirst?: boolean
}

const { shots, eagerFirst = false, wideFirst = true } = Astro.props

const items = await Promise.all(
  shots.map(async (shot) => ({
    ...shot,
    name: shot.file,
    large: (await getImage({ src: shot.src, width: 1600, format: 'webp', quality: 82 })).src,
  })),
)
---

<ul class="gallery">
  {items.map((shot, index) => (
    <li class:list={['cell', { 'cell--wide': wideFirst && index === 0 }]}>
      <button
        class="trigger"
        type="button"
        data-shot={shot.large}
        data-caption={shot.caption}
        aria-label={`放大查看：${shot.caption}`}
      >
        <span class="media">
          <Image
            src={shot.src}
            alt={shot.alt}
            widths={[640, 1024]}
            sizes={index === 0 ? '(min-width: 1100px) 1120px, 94vw' : '(min-width: 1100px) 552px, 94vw'}
            loading={eagerFirst && index === 0 ? 'eager' : 'lazy'}
            format="webp"
            quality={82}
          />
        </span>
        <span class="meta">
          <span class="f">{shot.name}</span>
          <span class="cap">{shot.caption}</span>
        </span>
      </button>
    </li>
  ))}
</ul>

<dialog class="lightbox" aria-label="截图预览" aria-modal="true" data-zoom="false">
  <div class="toolbar">
    <span class="hint mono">screenshot — 点击放大 · Esc 关闭</span>
    <button class="zoom" type="button" aria-pressed="false">放大</button>
    <button class="close" type="button" aria-label="关闭预览">close ✕</button>
  </div>
  <div class="stage"></div>
  <p class="caption mono"></p>
</dialog>

<script is:inline>
  ;(() => {
    const dialog = document.querySelector('.lightbox')
    if (!dialog) return
    const stage = dialog.querySelector('.stage')
    const caption = dialog.querySelector('.caption')
    const close = dialog.querySelector('.close')
    const zoom = dialog.querySelector('.zoom')
    if (!stage || !caption || !close || !zoom) return

    const resetZoom = () => {
      dialog.dataset.zoom = 'false'
      zoom.setAttribute('aria-pressed', 'false')
      zoom.textContent = '放大'
      stage.scrollTo(0, 0)
    }

    document.querySelectorAll('[data-shot]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const image = document.createElement('img')
        image.className = 'zoom-image'
        image.src = btn.dataset.shot
        image.alt = btn.querySelector('img')?.alt ?? ''
        stage.replaceChildren(image)
        caption.textContent = btn.dataset.caption ?? ''
        resetZoom()
        dialog.showModal()
        close.focus()
      })
    })

    zoom.addEventListener('click', () => {
      const isZoomed = dialog.dataset.zoom !== 'true'
      dialog.dataset.zoom = String(isZoomed)
      zoom.setAttribute('aria-pressed', String(isZoomed))
      zoom.textContent = isZoomed ? '适应' : '放大'
      stage.scrollTo(0, 0)
    })

    close.addEventListener('click', () => dialog.close())
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
    dialog.addEventListener('close', resetZoom)
  })()
</script>

<style>
  .gallery {
    display: grid;
    align-items: start;
    gap: 22px 20px;
  }

  .trigger {
    display: grid;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: zoom-in;
  }

  .media {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--panel);
    transition: border-color var(--dur) var(--ease);
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .trigger:hover .media {
    border-color: var(--dim-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
    padding-top: 7px;
    font-size: 10.5px;
  }

  .f {
    color: var(--amber);
  }

  .cap {
    flex: 1 1 12ch;
    min-width: 0;
    color: var(--dim);
  }

  @media (min-width: 760px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cell--wide {
      grid-column: 1 / -1;
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: min(1240px, calc(100vw - 24px));
    max-height: calc(100vh - 24px);
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--dim-2);
    background: var(--panel);
    color: var(--fg);
  }

  .lightbox::backdrop {
    background: rgba(4, 5, 5, 0.86);
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--rule);
    background: var(--panel-2);
  }

  .hint {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--dim-2);
    font-size: 10.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .zoom,
  .close {
    padding: 5px 11px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .zoom:hover,
  .close:hover {
    border-color: var(--green);
    color: var(--green);
  }

  .zoom[aria-pressed='true'] {
    border-color: var(--green);
    color: var(--green);
  }

  .stage {
    max-height: calc(100vh - 120px);
    padding: 10px;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .stage :global(.zoom-image) {
    display: block;
    width: 100%;
    max-height: calc(100vh - 150px);
    object-fit: contain;
  }

  .lightbox[data-zoom='true'] .stage :global(.zoom-image) {
    width: max(100%, 980px);
    max-width: none;
    max-height: none;
    height: auto;
  }

  .caption {
    padding: 8px 12px 10px;
    border-top: 1px solid var(--rule);
    color: var(--dim);
    font-size: 10.5px;
  }
</style>
