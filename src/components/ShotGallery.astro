---
import { Image, getImage } from 'astro:assets'
import type { Shot } from '../data/products'

interface Props {
  shots: Shot[]
  eagerFirst?: boolean
}

const { shots, eagerFirst = false } = Astro.props

const items = await Promise.all(
  shots.map(async (shot) => ({
    ...shot,
    large: (await getImage({ src: shot.src, width: 1600, format: 'webp', quality: 82 })).src,
  })),
)
---

<ul class="gallery">
  {items.map((shot, index) => (
    <li class:list={['shot', { 'shot--wide': index === 0 }]}>
      <button class="shot-trigger" type="button" data-shot={shot.large} data-caption={shot.caption}>
        <span class="shot-media">
          <Image
            src={shot.src}
            alt={shot.alt}
            widths={[640, 1024]}
            sizes={index === 0 ? '(min-width: 980px) 1160px, 94vw' : '(min-width: 980px) 570px, 94vw'}
            loading={eagerFirst && index === 0 ? 'eager' : 'lazy'}
            format="webp"
            quality={82}
          />
        </span>
        <span class="shot-caption">{shot.caption}</span>
      </button>
    </li>
  ))}
</ul>

<dialog class="lightbox" aria-label="截图预览" aria-modal="true" data-zoom="false">
  <div class="lightbox-toolbar">
    <button class="lightbox-zoom" type="button" aria-pressed="false">放大查看</button>
    <button class="lightbox-close" type="button" aria-label="关闭预览">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <div class="lightbox-media"></div>
  <p class="lightbox-caption mono"></p>
</dialog>

<script is:inline>
  ;(() => {
    const dialog = document.querySelector('.lightbox')
    if (!dialog) return
    const media = dialog.querySelector('.lightbox-media')
    const caption = dialog.querySelector('.lightbox-caption')
    const close = dialog.querySelector('.lightbox-close')
    const zoom = dialog.querySelector('.lightbox-zoom')
    if (!media || !caption || !close || !zoom) return

    const resetZoom = () => {
      dialog.dataset.zoom = 'false'
      zoom.setAttribute('aria-pressed', 'false')
      zoom.textContent = '放大查看'
      media.scrollTo(0, 0)
    }

    document.querySelectorAll('[data-shot]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const image = document.createElement('img')
        image.className = 'lightbox-image'
        image.src = btn.dataset.shot
        image.alt = btn.querySelector('img')?.alt ?? ''
        media.replaceChildren(image)
        caption.textContent = btn.dataset.caption ?? ''
        resetZoom()
        dialog.showModal()
        close.focus()
      })
    })

    zoom.addEventListener('click', () => {
      const isZoomed = dialog.dataset.zoom !== 'true'
      dialog.dataset.zoom = String(isZoomed)
      zoom.setAttribute('aria-pressed', String(isZoomed))
      zoom.textContent = isZoomed ? '适应窗口' : '放大查看'
      media.scrollTo(0, 0)
    })

    close.addEventListener('click', () => dialog.close())
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
    dialog.addEventListener('close', resetZoom)
  })()
</script>

<style>
  .gallery {
    display: grid;
    gap: 14px;
    list-style: none;
  }

  .shot-trigger {
    display: grid;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: zoom-in;
  }

  .shot-media {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur var(--ease)),
      transform var(--dur var(--ease));
  }

  .shot-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot-trigger:hover .shot-media {
    border-color: var(--project-accent, var(--accent));
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .shot-caption {
    display: block;
    padding-top: 9px;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (min-width: 720px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shot--wide {
      grid-column: 1 / -1;
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: min(1240px, calc(100vw - 28px));
    max-height: calc(100vh - 28px);
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .lightbox::backdrop {
    background: rgba(8, 12, 16, 0.78);
  }

  .lightbox-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding: 7px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .lightbox-zoom {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 650;
    cursor: pointer;
  }

  .lightbox-zoom:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }

  .lightbox-zoom[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .lightbox-media {
    max-height: calc(100vh - 150px);
    padding: 12px;
    overflow: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .lightbox-media :global(.lightbox-image) {
    display: block;
    width: 100%;
    max-height: calc(100vh - 180px);
    object-fit: contain;
  }

  .lightbox-caption {
    margin: 0;
    padding: 10px 14px 12px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.75rem;
  }

  .lightbox-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .lightbox-close svg {
    width: 18px;
    height: 18px;
  }

  .lightbox[data-zoom='true'] .lightbox-media :global(.lightbox-image) {
    width: max(100%, 980px);
    max-width: none;
    max-height: none;
    height: auto;
  }
</style>
