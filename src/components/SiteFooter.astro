---
import { products } from '../data/products'

const shotCount = products.reduce((sum, product) => sum + product.shots.length, 0)
const year = new Date().getFullYear()
---

<footer class="foot">
  <div class="wrap inner">
    <p class="ok">
      <span class="accent">[ok]</span>
      {products.length} 个项目 · {shotCount} 张截图 · 无账号 · 无统计脚本
    </p>

    <div class="links">
      <a href="https://github.com/LijunTong" rel="noopener" target="_blank">
        github.com/LijunTong<span class="ext" aria-hidden="true"> ↗</span>
      </a>
      <span class="dim-2">© {year} JT 出品</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: 64px;
    border-top: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 18px 28px;
    font-size: 11.5px;
  }

  .ok {
    color: var(--dim);
  }

  .ok :global(.accent) {
    margin-right: 6px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .links a {
    color: var(--dim);
    transition: color var(--dur) var(--ease);
  }

  .links a:hover {
    color: var(--green);
  }

  .ext {
    color: var(--dim-2);
  }
</style>
