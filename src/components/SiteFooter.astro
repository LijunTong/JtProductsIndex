---
import { withBase } from '../lib/url'
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-name">
        <span class="brand-mark" aria-hidden="true">JT</span>
        <span>JT 工具集</span>
      </div>
      <p class="footer-note">本地优先的桌面工具，数据留在你自己的机器上。</p>
    </div>

    <nav class="footer-links" aria-label="页脚导航">
      <a href={withBase('/#products')}>产品</a>
      <a href="https://github.com/LijunTong/work-station" rel="noopener" target="_blank">工作台源码</a>
      <a href="https://github.com/LijunTong/Something" rel="noopener" target="_blank">几件事源码</a>
      <a href="https://github.com/LijunTong" rel="noopener" target="_blank">GitHub</a>
    </nav>

    <p class="footer-meta mono">© {year} joont · 构建于 Astro · 无账户、无追踪</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: clamp(40px, 5vw, 64px);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-6);
  }

  .footer-brand {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .footer-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .footer-note {
    max-width: 32ch;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 0.875rem;
  }

  .footer-links a {
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-meta {
    color: var(--faint);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  @media (min-width: 860px) {
    .footer-inner {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }

    .footer-links {
      justify-content: flex-end;
    }

    .footer-meta {
      grid-column: 1 / -1;
      padding-top: var(--space-5);
      border-top: 1px solid var(--border);
    }
  }
</style>
