---
import { withBase } from '../lib/url'

const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="footer-name" href={withBase('/')}>
        <span class="brand-mark" aria-hidden="true">JT</span>
        <span>JT 出品</span>
      </a>
      <p class="footer-note">自己做、自己用的软件。数据尽量留在你自己的机器上。</p>
    </div>

    <nav class="footer-links" aria-label="页脚导航">
      <a href={withBase('/#projects')}>项目</a>
      <a href="https://github.com/LijunTong/work-station" rel="noopener" target="_blank">工作台源码</a>
      <a href="https://github.com/LijunTong/Something" rel="noopener" target="_blank">几件事源码</a>
      <a href="https://github.com/LijunTong" rel="noopener" target="_blank">GitHub</a>
    </nav>

    <p class="footer-meta mono">© {year} joont · Astro · 无账户、无追踪</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 44px 28px;
  }

  .footer-inner {
    display: grid;
    gap: 28px;
  }

  .footer-brand {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .footer-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    font-weight: 700;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.6563rem;
    font-weight: 700;
    line-height: 1;
  }

  .footer-note {
    max-width: 38ch;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 0.875rem;
  }

  .footer-links a {
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-meta {
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.6875rem;
  }

  @media (min-width: 820px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
      align-items: start;
    }

    .footer-links {
      justify-content: flex-end;
    }

    .footer-meta {
      grid-column: 1 / -1;
    }
  }
</style>
