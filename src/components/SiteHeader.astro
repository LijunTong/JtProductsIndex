---
import { withBase } from '../lib/url'

const links = [
  { href: withBase('/#projects'), label: '项目' },
  { href: withBase('/#principles'), label: '原则' },
  { href: withBase('/#about'), label: '关于' },
  { href: 'https://github.com/LijunTong', label: 'GitHub', external: true },
]
---

<header class="top">
  <div class="wrap bar">
    <a class="who" href={withBase('/')} aria-label="JT 出品，返回首页">
      <span class="host" aria-hidden="true">jt@local:~$</span>
      <span class="brand">JT 出品</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}
        >
          {link.label}
          {link.external && <span class="ext" aria-hidden="true">↗</span>}
        </a>
      ))}
    </nav>

    <div class="rt">
      <button class="tb" type="button" data-theme-toggle aria-pressed="true">
        theme: <span data-theme-label>dark</span>
      </button>
      <span class="ver" aria-hidden="true">v1.0 · 2026</span>
    </div>
  </div>
</header>

<script is:inline>
  ;(() => {
    const root = document.documentElement
    const sync = () => {
      const theme = root.dataset.theme === 'light' ? 'light' : 'dark'
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(theme === 'dark'))
        btn.setAttribute('aria-label', theme === 'dark' ? '当前深色，切换到浅色' : '当前浅色，切换到深色')
      })
      document.querySelectorAll('[data-theme-label]').forEach((el) => {
        el.textContent = theme
      })
    }
    sync()
    document.addEventListener('click', (event) => {
      const btn = event.target.closest('[data-theme-toggle]')
      if (!btn) return
      const next = root.dataset.theme === 'light' ? 'dark' : 'light'
      root.dataset.theme = next
      root.style.colorScheme = next
      try {
        localStorage.setItem('theme', next)
      } catch {}
      const meta = document.querySelector('meta[name="theme-color"]')
      if (meta) meta.setAttribute('content', next === 'light' ? '#F6F6F2' : '#08090A')
      sync()
    })
  })()
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    min-height: var(--header-h);
    padding-block: 8px;
  }

  .who {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    min-height: 24px;
    min-width: 0;
  }

  .host {
    color: var(--green);
  }

  .brand {
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-height: 24px;
    color: var(--dim);
    font-size: 12px;
    transition: color var(--dur) var(--ease);
  }

  .nav a:hover {
    color: var(--green);
  }

  .ext {
    color: var(--dim-2);
    font-size: 11px;
  }

  .rt {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-inline-start: auto;
  }

  .tb {
    padding: 3px 9px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .tb:hover {
    border-color: var(--dim-2);
    color: var(--fg);
  }

  .tb [data-theme-label] {
    color: var(--fg);
  }

  .ver {
    color: var(--dim-2);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .nav {
      order: 3;
      flex-basis: 100%;
      gap: 16px;
      padding-top: 2px;
    }
  }

  @media (max-width: 460px) {
    .ver {
      display: none;
    }
  }
</style>
