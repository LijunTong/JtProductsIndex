---
import { withBase } from '../lib/url'

const links = [
  { href: withBase('/#products'), label: '产品' },
  { href: withBase('/#principles'), label: '原则' },
  { href: 'https://github.com/LijunTong', label: 'GitHub', external: true },
]
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="JT 工具集，返回首页">
      <span class="brand-mark" aria-hidden="true">JT</span>
      <span class="brand-name">工具集</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="切换浅色主题">
        <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
      </button>

      <details class="menu">
        <summary aria-label="打开导航菜单">菜单</summary>
        <nav aria-label="移动端导航">
          {links.map((link) => (
            <a
              href={link.href}
              {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  ;(() => {
    const root = document.documentElement
    const syncPressed = () => {
      const isLight = root.dataset.theme === 'light'
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(isLight))
      })
    }
    syncPressed()
    document.addEventListener('click', (event) => {
      const btn = event.target.closest('[data-theme-toggle]')
      if (!btn) return
      const next = root.dataset.theme === 'light' ? 'dark' : 'light'
      root.dataset.theme = next
      root.style.colorScheme = next
      try {
        localStorage.setItem('theme', next)
      } catch {}
      const meta = document.querySelector('meta[name="theme-color"]')
      if (meta) meta.setAttribute('content', next === 'light' ? '#F6F7F9' : '#0B1015')
      syncPressed()
    })
  })()
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .brand-name {
    font-size: var(--step-0);
  }

  .nav {
    display: flex;
    gap: var(--space-5);
    margin-inline-start: auto;
    font-size: var(--step--1);
  }

  .nav a {
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .nav a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .icon {
    width: 18px;
    height: 18px;
  }

  .icon--sun {
    display: none;
  }

  :global([data-theme='light']) .icon--sun {
    display: block;
  }

  :global([data-theme='light']) .icon--moon {
    display: none;
  }

  .menu {
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    min-width: 56px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: var(--step--1);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    display: grid;
    min-width: 140px;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }

  .menu nav a {
    padding: 8px 12px;
    border-radius: 6px;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .menu nav a:hover {
    background: var(--elevated);
    color: var(--text);
  }

  @media (max-width: 720px) {
    .nav {
      display: none;
    }

    .actions {
      margin-inline-start: auto;
    }

    .brand-name {
      display: none;
    }
  }

  @media (min-width: 721px) {
    .menu {
      display: none;
    }
  }
</style>
