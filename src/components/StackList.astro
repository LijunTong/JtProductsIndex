---
interface Props {
  stack: { label: string; items: string[] }[]
}

const { stack } = Astro.props
---

<ul class="stack">
  {stack.map((group) => (
    <li class="stack-row">
      <p class="label">{group.label}</p>
      <p class="items">{group.items.join(' · ')}</p>
    </li>
  ))}
</ul>

<style>
  .stack {
    display: grid;
    border-top: 1px solid var(--border-strong);
    list-style: none;
  }

  .stack-row {
    display: grid;
    gap: 4px;
    padding-block: 14px;
    border-bottom: 1px solid var(--border);
  }

  .label {
    color: var(--faint);
    font-size: 0.75rem;
  }

  .items {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.55;
  }

  @media (min-width: 720px) {
    .stack-row {
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 24px;
      align-items: baseline;
    }
  }
</style>
