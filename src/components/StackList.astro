---
interface Props {
  stack: { label: string; items: string[] }[]
}

const { stack } = Astro.props
---

<dl class="stack">
  {stack.map((group) => (
    <div class="row">
      <dt>{group.label}</dt>
      <dd>{group.items.join(' · ')}</dd>
    </div>
  ))}
</dl>

<style>
  .stack {
    margin: 0;
    border-top: 1px solid var(--rule-soft);
  }

  .row {
    display: grid;
    grid-template-columns: 8.5ch minmax(0, 1fr);
    gap: 12px;
    padding-block: 7px;
    border-bottom: 1px solid var(--rule-soft);
    font-size: 12px;
    line-height: 1.6;
  }

  dt {
    color: var(--dim-2);
  }

  dd {
    margin: 0;
    color: var(--fg);
  }
</style>
