---
import BaseLayout from './BaseLayout.astro'
import ProjectPreview from '../components/ProjectPreview.astro'
import SectionHeading from '../components/SectionHeading.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import ShotGallery from '../components/ShotGallery.astro'
import DownloadTable from '../components/DownloadTable.astro'
import StackList from '../components/StackList.astro'
import { withBase } from '../lib/url'
import { products, type Product } from '../data/products'

interface Props {
  product: Product
}

const { product } = Astro.props
const others = products.filter((p) => p.slug !== product.slug)
const [cover, ...gallery] = product.shots

const cta = product.cta ?? { label: `下载 ${product.name}`, href: product.releases ?? product.repo }
const ctaExternal = !cta.href.startsWith('#')

const origin = Astro.site ?? new URL('https://lijuntong.github.io')
const pageUrl = new URL(withBase(`/${product.slug}/`), origin).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${product.name}（${product.englishName}）`,
  applicationCategory: 'ProductivityApplication',
  operatingSystem: product.platforms.join(', '),
  softwareVersion: product.version,
  description: product.summary,
  url: pageUrl,
  downloadUrl: product.releases ?? product.repo,
  isAccessibleForFree: true,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: 'joont', url: 'https://github.com/LijunTong' },
  screenshot: new URL(withBase(cover.src.src), origin).href,
}
---

<BaseLayout
  title={`${product.name} ${product.englishName} · JT 出品`}
  description={product.summary}
  ogType="article"
  ogImage={cover.src.src}
  jsonLd={jsonLd}
>
  <div class="product-page" data-tone={product.tone}>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <a class="back text-link" href={withBase('/#projects')}>
            <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M12 8H4M7 5 4 8l3 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            全部项目
          </a>

          <div class="project-meta">
            <span class="tag tag--status">{product.statusLabel}</span>
            <span class="tag">{product.kindLabel}</span>
            <span class="project-year mono">{product.year}</span>
          </div>

          <h1>{product.name}</h1>
          <p class="tagline">{product.tagline}</p>
          <p class="summary">{product.summary}</p>

          <p class="hero-meta mono">
            {product.platforms.join(' / ')} · v{product.version}
          </p>

          <div class="actions">
            <a
              class="btn btn--primary"
              href={cta.href}
              rel={ctaExternal ? 'noopener' : undefined}
              target={ctaExternal ? '_blank' : undefined}
            >
              {cta.label}
              <svg class="icon" viewBox="0 0 18 18" aria-hidden="true">
                <path d="M9 2.5v8M6 7.8l3 3 3-3M3.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a class="btn btn--quiet" href={product.repo} rel="noopener" target="_blank">
              查看源码
              <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>

        <ProjectPreview
          product={product}
          cover={cover}
          loading="eager"
          sizes="(min-width: 1000px) 690px, 94vw"
          widths={[640, 960, 1440]}
        />
      </div>
    </section>

    <div class="metrics">
      <div class="container metrics-grid">
        {product.metrics.map((metric) => (
          <div class="metric">
            <span class="metric-value">{metric.value}</span>
            <span class="metric-label">{metric.label}</span>
          </div>
        ))}
      </div>
    </div>

    <section class="section features-section">
      <div class="container">
        <SectionHeading
          title="能做什么"
          description="围绕每天真正会用到的动作组织，不把功能堆成一张清单。"
        />
        <div class="block">
          <FeatureGrid features={product.features} columns={3} />
        </div>
      </div>
    </section>

    <section class="section section--muted">
      <div class="container">
        <SectionHeading title="界面" description="点击任意一张截图查看完整界面。" />
        <div class="block">
          <ShotGallery shots={gallery} eagerFirst />
        </div>
      </div>
    </section>

    <section id="install" class="section">
      <div class="container">
        <SectionHeading
          title="运行与安装"
          description="运行环境、安装方式和数据位置都放在这一处。"
        />

        <div class="details-grid">
          <div class="stack-block">
            <h3>技术构成</h3>
            <StackList stack={product.stack} />
          </div>

          <div class="download-block">
            <h3>{product.install ? '安装' : '下载'}</h3>

            {product.install ? (
              <div class="install">
                <p class="install-note">{product.install.note}</p>
                <pre class="install-command"><code>{product.install.command}</code></pre>
                <ol class="install-steps">
                  {product.install.steps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              </div>
            ) : (
              <DownloadTable downloads={product.downloads} releases={product.releases} />
            )}

            <div class="notes">
              <div>
                <h4>运行环境</h4>
                <ul>
                  {product.requirements.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <h4>你的数据</h4>
                <p>{product.dataNote}</p>
              </div>
            </div>

            <p class="notes-source mono">
              源码：
              <a href={product.repo} rel="noopener" target="_blank">
                {product.repo.replace('https://', '')}
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <nav class="next container" aria-label="其他项目">
      <a href={withBase('/#projects')}>
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M12 8H4M7 5 4 8l3 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        返回全部项目
      </a>
      {others.map((other) => (
        <a href={withBase(`/${other.slug}/`)}>
          接着看：{other.name}
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4 8h8M9 5l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
    </nav>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(34px, 4.5vw, 64px) clamp(48px, 6vw, 80px);
  }

  .hero-grid {
    display: grid;
    min-width: 0;
    gap: clamp(30px, 4vw, 56px);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    min-width: 0;
    justify-items: start;
    gap: 16px;
  }

  .back {
    font-size: 0.8125rem;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: 4px;
  }

  .project-year {
    color: var(--faint);
    font-size: 0.75rem;
  }

  h1 {
    font-size: clamp(2.8rem, 5.2vw, 4.4rem);
    line-height: 1;
  }

  .tagline {
    max-width: 28ch;
    text-wrap: balance;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 650;
    line-height: 1.45;
  }

  .summary {
    max-width: 52ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.72;
  }

  .hero-meta {
    color: var(--faint);
    font-size: 0.6875rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .product-page :global(.hero .preview) {
    box-shadow: var(--shadow-lg);
  }

  .metrics {
    border-block: 1px solid var(--border);
    background: var(--surface-2);
  }

  .metrics-grid {
    display: grid;
    gap: 0;
  }

  .metric {
    display: grid;
    gap: 4px;
    padding-block: 18px;
  }

  .metric + .metric {
    border-top: 1px solid var(--border);
  }

  .metric-value {
    color: var(--project-ink);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .metric-label {
    max-width: 34ch;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .block {
    margin-top: clamp(26px, 3vw, 40px);
  }

  .details-grid {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
    margin-top: clamp(26px, 3vw, 40px);
  }

  .stack-block,
  .download-block {
    display: grid;
    gap: 14px;
    align-content: start;
    min-width: 0;
  }

  .stack-block > h3,
  .download-block > h3 {
    font-size: 1.125rem;
  }

  .install {
    display: grid;
    gap: 14px;
  }

  .install-note {
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .install-command {
    padding: 13px 15px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: pre;
  }

  .install-steps {
    display: grid;
    gap: 7px;
    counter-reset: step;
    list-style: none;
  }

  .install-steps li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 8px;
    align-items: baseline;
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.65;
    counter-increment: step;
  }

  .install-steps li::before {
    content: counter(step);
    color: var(--project-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .notes {
    display: grid;
    gap: 14px;
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .notes h4 {
    margin-bottom: 6px;
    font-size: 0.875rem;
  }

  .notes ul {
    display: grid;
    gap: 3px;
    list-style: none;
  }

  .notes li,
  .notes p {
    max-width: 66ch;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .notes-source {
    padding-top: 14px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    overflow-wrap: anywhere;
  }

  .notes-source a {
    color: var(--muted);
    text-underline-offset: 4px;
  }

  .notes-source a:hover {
    color: var(--project-ink);
    text-decoration: underline;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 28px;
    border-top: 1px solid var(--border);
  }

  .next a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .next a:hover {
    color: var(--text);
  }

  @media (min-width: 720px) {
    .metrics-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .metric {
      padding-block: 20px;
    }

    .metric + .metric {
      padding-inline-start: 24px;
      border-top: 0;
      border-inline-start: 1px solid var(--border);
    }

    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(360px, 0.8fr) minmax(0, 1.2fr);
    }

    .details-grid {
      grid-template-columns: minmax(260px, 0.62fr) minmax(0, 1.38fr);
      gap: clamp(48px, 6vw, 88px);
    }
  }
</style>
