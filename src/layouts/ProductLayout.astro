---
import { Image } from 'astro:assets'
import BaseLayout from './BaseLayout.astro'
import SectionHeading from '../components/SectionHeading.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import ShotGallery from '../components/ShotGallery.astro'
import DownloadTable from '../components/DownloadTable.astro'
import StackList from '../components/StackList.astro'
import { withBase } from '../lib/url'
import { products, type Product } from '../data/products'

interface Props {
  product: Product
}

const { product } = Astro.props
const others = products.filter((p) => p.slug !== product.slug)
const [cover, ...gallery] = product.shots

const origin = Astro.site ?? new URL('https://lijuntong.github.io')
const pageUrl = new URL(withBase(`/${product.slug}/`), origin).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${product.name}（${product.englishName}）`,
  applicationCategory: 'ProductivityApplication',
  operatingSystem: product.platforms.join(', '),
  softwareVersion: product.version,
  description: product.summary,
  url: pageUrl,
  downloadUrl: product.releases,
  isAccessibleForFree: true,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: 'joont', url: 'https://github.com/LijunTong' },
  screenshot: new URL(withBase(cover.src.src), origin).href,
}
---

<BaseLayout
  title={`${product.name} ${product.englishName} · JT 出品`}
  description={product.summary}
  ogType="article"
  ogImage={cover.src.src}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <a class="back mono" href={withBase('/#products')}>← 全部产品</a>
        <p class="eyebrow">{product.englishName} · v{product.version}</p>
        <h1>{product.name}</h1>
        <p class="tagline">{product.tagline}</p>
        <p class="summary">{product.summary}</p>
        <p class="hero-meta mono">{product.platforms.join(' · ')} · v{product.version}</p>
        <div class="actions">
          <a class="btn btn--primary" href={product.releases} rel="noopener" target="_blank">下载 {product.name}</a>
          <a class="btn btn--text" href={product.repo} rel="noopener" target="_blank">源码<span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <figure class="window hero-window">
        <Image
          src={cover.src}
          alt={cover.alt}
          widths={[640, 1024, 1440]}
          sizes="(min-width: 960px) 560px, 92vw"
          loading="eager"
          format="webp"
          quality={84}
        />
        <figcaption>{cover.caption}</figcaption>
      </figure>
    </div>
  </section>

  <div class="facts">
    <div class="container facts-inner">
      {product.metrics.map((metric) => (
        <div class="fact">
          <span class="fact-value mono">{metric.value}</span>
          <span class="fact-label">{metric.label}</span>
        </div>
      ))}
    </div>
  </div>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="功能" title="它具体能做什么" />
      <div class="block">
        <FeatureGrid features={product.features} />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading eyebrow="界面" title="长这样。" description="点击任意一张放大查看。" />
      <div class="block">
        <ShotGallery shots={gallery} eagerFirst />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack-block">
      <SectionHeading eyebrow="技术栈" title="由什么构成" />
      <div class="block">
        <StackList stack={product.stack} />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading eyebrow="下载" title="安装与数据" />
      <div class="block download-block">
        <div>
          <DownloadTable downloads={product.downloads} releases={product.releases} />
        </div>
        <aside class="notes">
          <div>
            <h3 class="eyebrow">运行环境</h3>
            <ul>
              {product.requirements.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="eyebrow">你的数据</h3>
            <p>{product.dataNote}</p>
          </div>
          <p class="notes-source mono">
            源码：<a href={product.repo} rel="noopener" target="_blank">{product.repo.replace('https://', '')}</a>
          </p>
        </aside>
      </div>
    </div>
  </section>

  <nav class="next container" aria-label="其他产品">
    <a href={withBase('/')}>← 回首页</a>
    {others.map((other) => (
      <a href={withBase(`/${other.slug}/`)}>另一个：{other.name} →</a>
    ))}
  </nav>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(40px, 5vw, 72px) clamp(48px, 6vw, 88px);
  }

  .hero-inner {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .back {
    color: var(--faint);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    transition: color var(--dur-fast) var(--ease);
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(2.6rem, 5vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.028em;
  }

  .tagline {
    max-width: 22ch;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 560;
    line-height: 1.42;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .summary {
    max-width: 46ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.72;
  }

  .hero-meta {
    color: var(--faint);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: 6px;
  }

  .actions .btn--text span {
    transition: transform var(--dur-fast) var(--ease);
  }

  .actions .btn--text:hover span {
    transform: translate(2px, -2px);
  }

  .hero-window {
    box-shadow: var(--shadow-lg);
  }

  .facts {
    border-block: 1px solid var(--border);
    background: var(--surface-2);
  }

  .facts-inner {
    display: grid;
    gap: 18px;
    padding-block: 22px;
  }

  .fact {
    display: grid;
    gap: 2px;
  }

  .fact-value {
    color: var(--text);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .fact-label {
    color: var(--faint);
    font-size: 0.8125rem;
  }

  .section--alt {
    border-block: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-2) 55%, var(--bg));
  }

  .block {
    margin-top: clamp(32px, 4vw, 52px);
  }

  .download-block {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
  }

  .notes {
    display: grid;
    gap: 26px;
    align-content: start;
  }

  .notes h3 {
    margin-bottom: 8px;
  }

  .notes ul {
    display: grid;
    gap: 4px;
    color: var(--muted);
    font-size: 0.9063rem;
    line-height: 1.6;
    list-style: none;
  }

  .notes p {
    color: var(--muted);
    font-size: 0.9063rem;
    line-height: 1.72;
  }

  .notes-source {
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--faint);
  }

  .notes-source a {
    color: var(--muted);
    border-bottom: 1px solid var(--border-strong);
  }

  .notes-source a:hover {
    color: var(--accent);
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .next a:hover {
    color: var(--text);
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr 1.02fr;
    }

    .facts-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-7);
      padding-block: 26px;
    }

    .download-block {
      grid-template-columns: 1.05fr 1fr;
    }
  }
</style>
