---
import BaseLayout from './BaseLayout.astro'
import Plate from '../components/Plate.astro'
import SectionHeading from '../components/SectionHeading.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import ShotGallery from '../components/ShotGallery.astro'
import DownloadTable from '../components/DownloadTable.astro'
import StackList from '../components/StackList.astro'
import { withBase } from '../lib/url'
import { products } from '../data/products'
import type { Product } from '../lib/product'

interface Props {
  product: Product
}

const { product } = Astro.props
const others = products.filter((p) => p.slug !== product.slug)
const isPlugin = product.kind === 'plugin'
const hasDownloads = product.downloads.length > 0
const [cover, ...gallery] = product.shots

/** 获取这一段有三种形态：插件装进 DSH、有安装包列下载、只给仓库地址自己跑。 */
const obtain = product.install
  ? {
      command: isPlugin ? 'install' : 'get started',
      title: isPlugin ? '安装' : '获取',
      description: isPlugin
        ? '装进 DeepSeek Harness，不需要额外配置。'
        : '从仓库拿源码，在本机跑起来；没有安装包，也不用装依赖。',
      hint: isPlugin ? '在插件管理器里执行' : '在终端里执行',
    }
  : hasDownloads
    ? {
        command: 'ls releases/',
        title: '下载',
        description: '安装包都在 GitHub Releases，点开即下载。',
        hint: '',
      }
    : {
        command: 'cat obtain.md',
        title: '获取',
        description: '没有现成的安装包，从仓库取。',
        hint: '',
      }

/** 安装命令按 token 上色：命令名绿、参数名暗、参数值琥珀。 */
type CommandPart = { kind: 'text'; text: string; cls: string } | { kind: 'pair'; key: string; value: string }

const parts: CommandPart[] = (product.install?.command ?? '')
  .split(/(\s+)/)
  .filter(Boolean)
  .map((token) => {
    if (/^\s+$/.test(token)) return { kind: 'text', text: token, cls: '' }
    const eq = token.indexOf('=')
    if (eq > 0) {
      return { kind: 'pair', key: token.slice(0, eq), value: token.slice(eq + 1) }
    }
    return { kind: 'text', text: token, cls: /^[\w-]+$/.test(token) ? 'p' : 'arg' }
  })

const origin = Astro.site ?? new URL('https://lijuntong.github.io')
const pageUrl = new URL(withBase(`/${product.slug}/`), origin).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${product.name}（${product.englishName}）`,
  applicationCategory: 'ProductivityApplication',
  operatingSystem: product.platforms.join(', '),
  softwareVersion: product.version,
  description: product.summary,
  url: pageUrl,
  downloadUrl: product.releases ?? product.repo,
  isAccessibleForFree: true,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: 'joont', url: 'https://github.com/LijunTong' },
  screenshot: new URL(withBase(cover.src.src), origin).href,
}
---

<BaseLayout
  title={`${product.name} ${product.englishName} · JT 出品`}
  description={product.summary}
  ogType="article"
  ogImage={cover.src.src}
  jsonLd={jsonLd}
>
  <div class="page">
    <div class="wrap">
      <nav class="crumb" aria-label="位置">
        <a href={withBase('/#projects')}>~/products</a>
        <span class="dim-2">/</span>
        <span class="here">{product.slug}</span>
      </nav>
    </div>

    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-main">
          <h1>
            {product.name}
            <span class="en">{product.englishName}</span>
          </h1>
          <p class="tagline">{product.tagline}</p>
          <p class="summary">{product.summary}</p>
        </div>

        <dl class="meta-grid">
          <div>
            <dt>version</dt>
            <dd>v{product.version}</dd>
          </div>
          <div>
            <dt>kind</dt>
            <dd>{product.kindLabel}</dd>
          </div>
          <div>
            <dt>platforms</dt>
            <dd>{product.platforms.join(' · ')}</dd>
          </div>
          <div>
            <dt>state</dt>
            <dd class="state">{product.statusLabel}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="wrap section">
      <SectionHeading command={obtain.command} title={obtain.title} description={obtain.description} />

      {product.install ? (
        <div class="install">
          <p class="install-note">{product.install.note}</p>

          <div class="cmd">
            <div class="cmd-body">
              <code><span class="sigil">$</span>
                {parts.map((part) =>
                  part.kind === 'pair' ? (
                    <>
                      <span class="k">{part.key}</span>
                      <span class="eq">=</span>
                      <span class="v">{part.value}</span>
                    </>
                  ) : (
                    <span class={part.cls || undefined}>{part.text}</span>
                  ),
                )}
              </code>
            </div>
            <div class="cmd-bar">
              <button class="copy" type="button" data-copy={product.install.command}>copy</button>
              <span class="hint">{obtain.hint}</span>
              <a class="btn" href={product.repo} rel="noopener" target="_blank">源码 ↗</a>
            </div>
          </div>

          <ol class="steps">
            {product.install.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
      ) : hasDownloads ? (
        <DownloadTable downloads={product.downloads} releases={product.releases} />
      ) : (
        <div class="install">
          <p class="install-note">
            这个项目没有发布安装包，源码与说明在仓库里。{product.cta ? product.cta.label + '。' : ''}
          </p>
          <div class="cmd-bar">
            {product.cta && (
              <a class="btn btn--solid" href={product.cta.href} rel="noopener" target="_blank">
                {product.cta.label} ↗
              </a>
            )}
            <a class="btn" href={product.repo} rel="noopener" target="_blank">源码 ↗</a>
          </div>
        </div>
      )}
    </section>

    <section class="wrap section">
      <div class="specs">
        {product.metrics.map((metric) => (
          <div class="spec">
            <b>{metric.value}</b>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="wrap section">
      <SectionHeading
        command="cat features.md"
        title="能做什么"
        description="围绕每天真正会用到的动作组织，不把功能堆成一张清单。"
      />
      <div class="block">
        <FeatureGrid features={product.features} />
      </div>
    </section>

    <section class="wrap section">
      <SectionHeading
        command="open screens/"
        title="界面"
        description="点任意一张截图放大，看真实界面。"
      />

      <div class="block">
        <Plate
          shot={cover}
          loading="eager"
          sizes="(min-width: 1100px) 1120px, 94vw"
          ratio={isPlugin ? '4 / 3' : undefined}
          objectPosition={isPlugin ? 'center' : 'top left'}
        />
      </div>

      {gallery.length > 0 && (
        <div class="block">
          <ShotGallery shots={gallery} />
        </div>
      )}
    </section>

    <section class="wrap section">
      <SectionHeading
        command="cat runtime.md"
        title="运行与数据"
        description="运行环境、技术构成和数据放在哪里，都写在这里。"
      />

      <div class="facts">
        <div class="fact">
          <h3>运行环境</h3>
          <ul>
            {product.requirements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <div class="fact">
          <h3>你的数据</h3>
          <p>{product.dataNote}</p>
        </div>

        <div class="fact">
          <h3>技术构成</h3>
          <StackList stack={product.stack} />
        </div>
      </div>

      <p class="source">
        <span class="dim-2">src →</span>
        <a href={product.repo} rel="noopener" target="_blank">
          {product.repo.replace('https://', '')} ↗
        </a>
      </p>
    </section>

    <nav class="wrap next" aria-label="其他项目">
      <a href={withBase('/#projects')}>
        <span class="dim-2">←</span> 全部项目
      </a>
      <div class="others">
        {others.map((other) => (
          <a href={withBase(`/${other.slug}/`)}>
            接着看：{other.name} <span class="dim-2">→</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</BaseLayout>

<style>
  .page {
    padding-bottom: 8px;
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: 7px;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--dim);
    font-size: 11.5px;
  }

  .crumb a {
    transition: color var(--dur) var(--ease);
  }

  .crumb a:hover {
    color: var(--green);
  }

  .here {
    color: var(--fg);
  }

  .hero {
    padding-block: clamp(26px, 3.6vw, 44px) clamp(26px, 3.6vw, 42px);
  }

  .hero-grid {
    display: grid;
    gap: 26px;
  }

  .hero-main {
    min-width: 0;
  }

  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 16px;
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: clamp(34px, 6.6vw, 74px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .en {
    color: var(--dim-2);
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.1vw, 13px);
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .tagline {
    max-width: 34ch;
    margin-top: 14px;
    color: var(--fg);
    font-size: clamp(14px, 1.7vw, 17px);
    line-height: 1.6;
    text-wrap: balance;
  }

  .summary {
    max-width: 58ch;
    margin-top: 10px;
    color: var(--dim);
    font-size: 12.5px;
    line-height: 1.85;
    text-wrap: pretty;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--rule);
  }

  .meta-grid > div {
    display: grid;
    gap: 2px;
    padding: 9px 11px;
    background: var(--panel);
  }

  .meta-grid dt {
    color: var(--dim-2);
    font-size: 9.5px;
    letter-spacing: 0.12em;
  }

  .meta-grid dd {
    margin: 0;
    color: var(--fg);
    font-size: 11.5px;
    overflow-wrap: anywhere;
  }

  .state {
    color: var(--green);
  }

  .state::before {
    content: '● ';
  }

  .section {
    padding-block: clamp(26px, 3.4vw, 40px);
    border-top: 1px solid var(--rule);
  }

  .block {
    margin-top: 16px;
  }

  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: 16px;
  }

  .install > * {
    min-width: 0;
  }

  .install-note {
    max-width: 66ch;
    color: var(--dim);
    font-size: 12.5px;
    line-height: 1.8;
  }

  .cmd {
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .cmd-body {
    padding: 13px 14px;
    overflow-x: auto;
    font-size: 12px;
    line-height: 1.7;
    white-space: pre;
  }

  .cmd-body code {
    font-family: var(--font-mono);
  }

  .sigil {
    margin-inline-end: 8px;
    color: var(--green);
  }

  .k {
    color: var(--fg);
  }

  .eq {
    color: var(--dim-2);
  }

  .v {
    color: var(--amber);
  }

  .p {
    color: var(--green);
  }

  .arg {
    color: var(--amber);
  }

  .copy {
    padding: 3px 9px;
    border: 1px solid var(--rule);
    background: none;
    color: var(--green);
    font: inherit;
    font-size: 11px;
    cursor: pointer;
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .copy:hover,
  .copy[data-state='done'] {
    border-color: var(--green);
    background: color-mix(in srgb, var(--green) 12%, transparent);
  }

  .hint {
    color: var(--dim);
  }

  .cmd-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 14px;
    padding: 7px 10px;
    border-top: 1px solid var(--rule);
    color: var(--dim-2);
    font-size: 10.5px;
  }

  .steps {
    display: grid;
    gap: 6px;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr);
    gap: 10px;
    max-width: 70ch;
    color: var(--dim);
    font-size: 12px;
    line-height: 1.75;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step) '.';
    color: var(--green);
    font-size: 11px;
  }

  .specs {
    display: grid;
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .spec {
    display: grid;
    gap: 5px;
    padding: clamp(14px, 1.8vw, 20px) clamp(14px, 2vw, 22px);
    border-bottom: 1px solid var(--rule);
  }

  .spec:last-child {
    border-bottom: 0;
  }

  .spec b {
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: clamp(24px, 3vw, 33px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .spec span {
    max-width: 30ch;
    color: var(--dim);
    font-size: 11.5px;
    line-height: 1.65;
  }

  .facts {
    display: grid;
    gap: 22px;
    margin-top: 16px;
  }

  .fact h3 {
    margin-bottom: 7px;
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .fact ul {
    display: grid;
    gap: 4px;
    border-top: 1px solid var(--rule-soft);
  }

  .fact li,
  .fact p {
    max-width: 68ch;
    padding-top: 5px;
    color: var(--dim);
    font-size: 12px;
    line-height: 1.75;
  }

  .fact ul + p,
  .fact p {
    border-top: 1px solid var(--rule-soft);
  }

  .source {
    padding-top: 10px;
    color: var(--dim);
    font-size: 11px;
    overflow-wrap: anywhere;
  }

  .source a {
    transition: color var(--dur) var(--ease);
  }

  .source a:hover {
    color: var(--green);
    text-decoration: underline;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    padding-block: 18px;
    border-top: 1px solid var(--rule);
    font-size: 11.5px;
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .next a {
    color: var(--dim);
    transition: color var(--dur) var(--ease);
  }

  .next a:hover {
    color: var(--green);
  }

  @media (max-width: 640px) {
    /* 窄屏上让命令自然折行，比横向滚动更好读；copy 复制的仍是完整命令 */
    .cmd-body {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }

  @media (min-width: 760px) {
    .specs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .spec {
      border-bottom: 0;
      border-inline-end: 1px solid var(--rule);
    }

    .spec:last-child {
      border-inline-end: 0;
    }

    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(240px, 0.7fr);
      gap: clamp(28px, 4vw, 56px);
      align-items: start;
    }
  }
</style>

<script is:inline>
  ;(() => {
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? ''
        try {
          await navigator.clipboard.writeText(text)
          btn.textContent = 'copied ✓'
          btn.dataset.state = 'done'
          setTimeout(() => {
            btn.textContent = 'copy'
            delete btn.dataset.state
          }, 1600)
        } catch {
          const code = document.querySelector('.cmd-body code')
          if (code) {
            const range = document.createRange()
            range.selectNodeContents(code)
            const selection = window.getSelection()
            selection?.removeAllRanges()
            selection?.addRange(range)
          }
          btn.textContent = '按 Ctrl+C'
          setTimeout(() => {
            btn.textContent = 'copy'
          }, 2400)
        }
      })
    })
  })()
</script>
