---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../lib/url'
---

<BaseLayout title="页面不存在 · JT 出品" description="没有找到这个页面。" noindex>
  <section class="wrap notfound">
    <p class="prompt">
      <span class="p">$</span> cat <span class="arg">这个地址</span>
    </p>
    <p class="code">cat: 这个地址: No such file or directory<span class="caret" aria-hidden="true"></span></p>

    <h1>这个页面不在这里</h1>
    <p class="sub">链接可能过期了，或者地址拼写有误。项目都在首页的索引表里。</p>

    <div class="actions">
      <a class="btn btn--solid" href={withBase('/')}>回首页</a>
      <a class="btn btn--ghost" href={withBase('/#projects')}>查看项目</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding-block: clamp(48px, 9vw, 120px) clamp(56px, 8vw, 96px);
  }

  .prompt {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--dim);
    font-size: 12px;
  }

  .p {
    color: var(--green);
  }

  .arg {
    color: var(--amber);
  }

  .code {
    display: flex;
    align-items: center;
    gap: 3px;
    color: var(--red);
    font-size: 12px;
  }

  .caret {
    width: 7px;
    height: 13px;
    background: var(--red);
    animation: blink 1.15s steps(1) infinite;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  h1 {
    margin-top: clamp(18px, 3vw, 32px);
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: clamp(30px, 5.6vw, 56px);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .sub {
    max-width: 52ch;
    margin-top: 4px;
    color: var(--dim);
    font-size: 12.5px;
    line-height: 1.85;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
      opacity: 1;
    }
  }
</style>
