---
import BaseLayout from '../layouts/BaseLayout.astro'
import Plate from '../components/Plate.astro'
import { products } from '../data/products'
import { describeIndex } from '../lib/product'
import { withBase } from '../lib/url'

const origin = Astro.site ?? new URL('https://lijuntong.github.io')
const homeUrl = new URL(withBase('/'), origin)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'JT 出品',
  alternateName: 'JT Works',
  url: homeUrl.href,
  description: 'JT 出品的桌面应用、软件项目和实验索引。',
  inLanguage: 'zh-CN',
  hasPart: products.map((product) => ({
    '@type': 'SoftwareApplication',
    name: product.name,
    applicationCategory: 'ProductivityApplication',
    operatingSystem: product.platforms.join(', '),
    url: new URL(withBase(`/${product.slug}/`), origin).href,
  })),
}

const principles = [
  {
    key: 'data',
    title: '数据留在本机',
    body: '待办、日程、邮件缓存写进本机的 SQLite 文件。没有云同步，也没有我们的服务器，因为根本没有服务器。',
  },
  {
    key: 'auth',
    title: '不需要账号',
    body: '下载、安装、打开就能用。只有主动配置邮箱时，才需要填一次自己的 IMAP 信息。',
  },
  {
    key: 'src',
    title: '看得见的实现',
    body: '应用的源码在 GitHub 上，安装包、版本号和更新日志都在 Release 页面，改了什么都查得到。',
  },
]

const covers = products.map((product) => ({
  product,
  cover:
    product.shots.find((shot) => shot.caption.includes('仪表盘')) ?? product.shots[0],
}))

const shotCount = products.reduce((sum, product) => sum + product.shots.length, 0)
const pad = (value: number) => String(value).padStart(2, '0')
---

<BaseLayout
  title="JT 出品 · 自己做、自己用的软件索引"
  description="JT 出品：工作台、几件事，以及给 DeepSeek Harness 写的 Git 分支控件。界面、功能和下载入口都在这里。"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="prompt">
        <span class="user">jt@local</span><span class="dim">:</span><span class="path">~</span><span class="p">$</span>
        <span class="cmd">ls -1 products/</span>
        <span class="caret" aria-hidden="true"></span>
      </p>

      <h1>
        自己做的东西，<br class="bw" />
        放在一个<em>清楚</em>的地方。
      </h1>

      <p class="sub">
        {describeIndex(products)}，都是本地优先的。
        界面、功能、下载入口都在这里 —— 没有账号，也没有统计脚本。
      </p>

      <p class="meta">
        <span>{products.length} 个项目</span>
        <span aria-hidden="true">·</span>
        <span>{shotCount} 张真实截图</span>
        <span aria-hidden="true">·</span>
        <span>能自己用，才值得做</span>
      </p>
    </div>
  </section>

  <section id="projects" class="wrap section">
    <h2 class="block">
      <span class="p" aria-hidden="true">$</span> index
    </h2>

    <div class="panel">
      <div class="thead" aria-hidden="true">
        <span>idx</span>
        <span>name</span>
        <span class="kind">kind</span>
        <span class="ver">ver</span>
        <span>state</span>
      </div>

      {products.map((product, index) => (
        <a class="row" href={withBase(`/${product.slug}/`)}>
          <span class="idx">{pad(index + 1)}</span>
          <span class="nm">
            {product.name}
            <small>{product.englishName}</small>
          </span>
          <span class="kind">{product.kindLabel}</span>
          <span class="ver">v{product.version}</span>
          <span class="state">{product.statusLabel}</span>
        </a>
      ))}
    </div>

    <p class="table-note dim-2">点任意一行进入项目页：真实截图、功能、运行要求与下载。</p>
  </section>

  <section class="wrap section">
    <h2 class="block">
      <span class="p" aria-hidden="true">$</span> cat selected/
    </h2>

    <div class="plates">
      {covers.map(({ product, cover }) => (
        <a class="plate-link" href={withBase(`/${product.slug}/`)} aria-label={`查看${product.name}`}>
          <Plate
            shot={cover}
            loading="lazy"
            sizes="(min-width: 1100px) 1120px, 94vw"
          />
        </a>
      ))}
    </div>
  </section>

  <section id="principles" class="wrap section">
    <h2 class="block">
      <span class="p" aria-hidden="true">$</span> cat principles.md
    </h2>

    <div class="keys">
      {principles.map((item) => (
        <div class="key">
          <h3>
            <span class="hash" aria-hidden="true">#</span>
            {item.title}
          </h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="about" class="wrap section">
    <h2 class="block">
      <span class="p" aria-hidden="true">$</span> cat about.md
    </h2>

    <div class="about">
      <div class="about-copy">
        <p class="lede">一个人做的工具，给自己每天用。</p>
        <p>
          日常里反复出现的动作，被做成应用，装上就能用。更新优先发在 GitHub 的 Release 页面。
          这个索引会继续收录不同类型的项目，但只放真实在做、真实能用的东西。
        </p>
      </div>

      <ul class="links">
        {products.map((product) => (
          <li>
            <a href={product.repo} rel="noopener" target="_blank">
              <span class="l">{product.name} 源码</span>
              <span class="r">{product.repo.replace('https://github.com/', '')} ↗</span>
            </a>
          </li>
        ))}
        <li>
          <a href="https://github.com/LijunTong" rel="noopener" target="_blank">
            <span class="l">GitHub 主页</span>
            <span class="r">@LijunTong ↗</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 78px) clamp(30px, 4vw, 44px);
  }

  .prompt {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: clamp(18px, 2.4vw, 26px);
    color: var(--dim);
    font-size: 11.5px;
    letter-spacing: 0.01em;
  }

  .user {
    color: var(--green);
  }

  .path {
    color: var(--fg);
  }

  .p {
    color: var(--green);
  }

  .cmd {
    color: var(--bright);
  }

  .caret {
    width: 7px;
    height: 14px;
    margin-inline-start: -2px;
    background: var(--green);
    animation: blink 1.15s steps(1) infinite;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  h1 {
    max-width: 20ch;
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: clamp(34px, 6.2vw, 76px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  h1 em {
    color: var(--green);
    font-style: normal;
  }

  .sub {
    max-width: 62ch;
    margin-top: clamp(16px, 2vw, 22px);
    color: var(--dim);
    font-size: 13px;
    line-height: 1.85;
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: clamp(18px, 2.4vw, 26px);
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    color: var(--dim-2);
    font-size: 10.5px;
    letter-spacing: 0.04em;
  }

  .section {
    padding-bottom: clamp(34px, 4.5vw, 52px);
  }

  .panel {
    border: 1px solid var(--rule);
  }

  .thead,
  .row {
    display: grid;
    grid-template-columns: 3.4ch minmax(0, 1fr) 9ch 8ch 7ch;
    gap: 12px;
    align-items: baseline;
  }

  .thead {
    padding: 7px 12px;
    border-bottom: 1px solid var(--rule);
    background: var(--panel-2);
    color: var(--dim-2);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .row {
    padding: 11px 12px;
    border-bottom: 1px solid var(--rule-soft);
    transition: background var(--dur) var(--ease);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row:hover {
    background: var(--panel);
  }

  .row:hover .nm {
    color: var(--green);
  }

  .idx {
    color: var(--dim-2);
    font-size: 11px;
  }

  .nm {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
    min-width: 0;
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color var(--dur) var(--ease);
  }

  .nm small {
    color: var(--dim-2);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 400;
  }

  .kind,
  .ver {
    color: var(--dim);
    font-size: 11.5px;
  }

  .state {
    color: var(--green);
    font-size: 11.5px;
  }

  .state::before {
    content: '● ';
  }

  .table-note {
    padding-top: 9px;
    font-size: 10.5px;
  }

  .plates {
    display: grid;
    gap: 26px;
  }

  .plate-link {
    display: block;
  }

  .plate-link:hover :global(.meta .cap) {
    color: var(--fg);
  }

  .keys {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  .key {
    display: grid;
    grid-template-columns: minmax(0, 13ch) minmax(0, 1fr);
    gap: 6px 28px;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .key h3 {
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.6;
  }

  .hash {
    color: var(--green);
  }

  .key p {
    max-width: 72ch;
    color: var(--dim);
    font-size: 12.5px;
    line-height: 1.8;
  }

  .about {
    display: grid;
    gap: 26px;
  }

  .about-copy {
    display: grid;
    gap: 10px;
    max-width: 64ch;
  }

  .lede {
    color: var(--bright);
    font-family: var(--font-sans);
    font-size: clamp(17px, 2.4vw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .about-copy p + p {
    color: var(--dim);
    font-size: 12.5px;
    line-height: 1.85;
  }

  .links {
    border-top: 1px solid var(--rule);
  }

  .links a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule-soft);
    font-size: 12px;
    transition: color var(--dur) var(--ease);
  }

  .links a:hover .l {
    color: var(--green);
  }

  .r {
    color: var(--dim-2);
    font-size: 11px;
  }

  @media (max-width: 900px) {
    .bw {
      display: none;
    }

    .thead,
    .row {
      grid-template-columns: 3.4ch minmax(0, 1fr) 7ch;
    }

    .kind,
    .ver {
      display: none;
    }

    .state {
      text-align: end;
    }
  }

  @media (max-width: 640px) {
    .key {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }

    .thead,
    .row {
      grid-template-columns: 3.4ch minmax(0, 1fr) auto;
      gap: 8px;
    }

    .nm small {
      flex-basis: 100%;
    }
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(36px, 5vw, 72px);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
      opacity: 1;
    }
  }
</style>
