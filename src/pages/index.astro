---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import { products } from '../data/products'
import { withBase } from '../lib/url'

const origin = Astro.site ?? new URL('https://lijuntong.github.io')
const homeUrl = new URL(withBase('/'), origin)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'JT 出品',
  alternateName: 'JT Works',
  url: homeUrl.href,
  description: '工作台与几件事：两个本地优先的桌面应用，管项目、任务、天气、日程和邮件。',
  inLanguage: 'zh-CN',
  hasPart: products.map((product) => ({
    '@type': 'SoftwareApplication',
    name: product.name,
    applicationCategory: 'ProductivityApplication',
    operatingSystem: product.platforms.join(', '),
    url: new URL(withBase(`/${product.slug}/`), origin).href,
  })),
}

const [workStation, something] = products

const facts = [
  { label: '平台', value: 'Windows 10/11 · Linux' },
  { label: '版本', value: `工作台 ${workStation.version} · 几件事 ${something.version}` },
  { label: '存储', value: 'SQLite 单文件，保存在本机' },
]

const principles = [
  {
    title: '数据留在本机',
    body: '待办、日程、邮件缓存写进本机的 SQLite 文件。没有云同步，也没有我们的服务器——因为根本没有服务器。',
  },
  {
    title: '不需要账号',
    body: '下载、安装、打开就能用。只有在你主动配置邮箱时，才需要填一次自己的 IMAP 信息。',
  },
  {
    title: '看得见的实现',
    body: '两个应用的源码都在 GitHub 上，安装包、版本号和更新日志都在 Release 页面，改了什么都查得到。',
  },
]

const cover = something.shots[0]
// 产品卡片优先用浅色界面截图，和纸色背景同一世界
const productCover = (slug: string) => {
  const product = products.find((item) => item.slug === slug)!
  return product.shots.find((shot) => shot.caption.includes('仪表盘')) ?? product.shots[0]
}
---

<BaseLayout
  title="JT 出品 · 自己做的桌面应用与网站"
  description="工作台与几件事：两个跑在自己电脑上的桌面应用，管项目、任务、天气、日程和邮件，数据存在本机。"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Desktop · 本地优先</p>
        <h1>把每天的事，<br />留在自己的<br class="br-tight" />电脑里。</h1>
        <p class="lead">
          工作台管项目和任务，几件事管天气、待办、日程和邮件。不需要注册账号，数据写在本机。
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="#products">看两个应用</a>
          <a class="btn btn--text" href="https://github.com/LijunTong" rel="noopener" target="_blank">
            GitHub<span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <figure class="window window--main">
          <Image
            src={cover.src}
            alt={cover.alt}
            widths={[720, 1080, 1440]}
            sizes="(min-width: 1000px) 640px, 92vw"
            loading="eager"
            format="webp"
            quality={84}
          />
          <figcaption>几件事 · 仪表盘</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="creed" aria-label="立场">
    <div class="container creed-inner">
      <p class="eyebrow">立场</p>
      <p class="creed-line">能自己用，<br />才值得做。</p>
      <p class="creed-note">
        现在两个桌面应用，以后会有网站，可能还有别的。共同点是：都自己做，也都自己用。
      </p>
    </div>
  </section>

  <div class="facts">
    <div class="container facts-inner">
      {facts.map((fact) => (
        <div class="fact">
          <span class="fact-label mono">{fact.label}</span>
          <span class="fact-value">{fact.value}</span>
        </div>
      ))}
    </div>
  </div>

  <section id="products" class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">两个应用</p>
        <h2>各管一半，<br />合起来是一天。</h2>
        <p class="lead">一个负责推着事情往前走，一个负责把当天的情报摆在一屏。都不联网也能用。</p>
      </header>

      <div class="products">
        {products.map((product, index) => (
          <article class:list={['product', { 'product--flip': index % 2 === 1 }]}>
            <figure class="window product-window">
              <Image
                src={productCover(product.slug).src}
                alt={productCover(product.slug).alt}
                widths={[720, 1080, 1440]}
                sizes="(min-width: 1000px) 620px, 92vw"
                loading="lazy"
                format="webp"
                quality={84}
              />
              <figcaption>{productCover(product.slug).caption}</figcaption>
            </figure>

            <div class="product-body">
              <p class="product-index mono">{String(index + 1).padStart(2, '0')}</p>
              <h3>{product.name}</h3>
              <p class="product-tagline">{product.tagline}</p>

              <ul class="product-points">
                {product.features.slice(0, 3).map((feature) => (
                  <li>
                    <span class="point-title">{feature.title}</span>
                    <span class="point-body">{feature.body}</span>
                  </li>
                ))}
              </ul>

              <p class="product-meta mono">
                {product.platforms.join(' · ')} · v{product.version}
              </p>

              <a class="product-link" href={withBase(`/${product.slug}/`)}>
                查看{product.name}<span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="principles" class="section">
    <div class="container principles-grid">
      <header class="principles-head">
        <p class="eyebrow">原则</p>
        <h2>为什么是<br />桌面应用</h2>
      </header>

      <ol class="principles">
        {principles.map((item, index) => (
          <li class="principle">
            <span class="principle-index mono">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section about-section">
    <div class="container about">
      <div class="about-copy">
        <p class="eyebrow">关于</p>
        <h2>一个人做的工具，<br />给自己每天用。</h2>
        <p>
          日常里反复出现的动作——记一件事、排今天的日程、看项目还剩多少——被做成两个应用，装上就能用。
          更新优先发在 GitHub 的 Release 页面。
        </p>
      </div>

      <ul class="about-links">
        <li>
          <a href={workStation.repo} rel="noopener" target="_blank">
            <span>工作台源码</span><span class="mono">work-station</span>
          </a>
        </li>
        <li>
          <a href={something.repo} rel="noopener" target="_blank">
            <span>几件事源码</span><span class="mono">Something</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/LijunTong" rel="noopener" target="_blank">
            <span>GitHub 主页</span><span class="mono">@LijunTong</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(48px, 6vw, 88px) clamp(56px, 7vw, 96px);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.3rem, 4.2vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.022em;
  }

  .br-tight {
    display: none;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: 6px;
  }

  .hero-actions .btn--text span {
    transition: transform var(--dur-fast) var(--ease);
  }

  .hero-actions .btn--text:hover span {
    transform: translate(2px, -2px);
  }

  .hero-visual {
    position: relative;
  }

  .window--main {
    box-shadow: var(--shadow-lg);
  }


  .creed {
    padding-block: clamp(36px, 4.5vw, 64px);
  }

  .creed-inner {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .creed-line {
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 560;
  }

  .creed-note {
    max-width: 30ch;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.72;
  }

  .facts {
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .facts-inner {
    display: grid;
    gap: 18px;
    padding-block: 22px;
  }

  .fact {
    display: grid;
    gap: 2px;
  }

  .fact-label {
    color: var(--faint);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .fact-value {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .section-head {
    display: grid;
    gap: 18px;
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .section-head h2,
  .principles-head h2,
  .about h2 {
    font-size: var(--step-3);
    letter-spacing: -0.04em;
  }

  .products {
    display: grid;
    gap: clamp(56px, 7vw, 112px);
  }

  .product {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    align-items: center;
  }

  .product-window {
    box-shadow: var(--shadow-lg);
  }

  .product-body {
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .product-index {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }

  .product-body h3 {
    font-size: clamp(1.9rem, 3.2vw, 2.75rem);
    letter-spacing: -0.045em;
  }

  .product-tagline {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .product-points {
    display: grid;
    width: 100%;
    margin-top: 6px;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .product-points li {
    display: grid;
    gap: 3px;
    padding-block: 13px;
    border-bottom: 1px solid var(--border);
  }

  .point-title {
    font-size: 0.9375rem;
    font-weight: 560;
  }

  .point-body {
    color: var(--muted);
    font-size: 0.9063rem;
    line-height: 1.68;
  }

  .product-meta {
    color: var(--faint);
    font-size: 0.75rem;
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border-strong);
    font-size: 0.9375rem;
    font-weight: 560;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .product-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .principles-grid {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
  }

  .principles-head {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .principles {
    display: grid;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .principle {
    display: grid;
    gap: 8px;
    padding-block: clamp(24px, 3vw, 34px);
    border-bottom: 1px solid var(--border);
  }

  .principle-index {
    color: var(--faint);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  .principle h3 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }

  .principle p {
    max-width: 56ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .about-section {
    border-top: 1px solid var(--border);
  }

  .about {
    display: grid;
    gap: clamp(32px, 4vw, 64px);
  }

  .about-copy {
    display: grid;
    gap: 18px;
    max-width: 56ch;
  }

  .about-copy p:last-child {
    color: var(--muted);
  }

  .about-links {
    display: grid;
    align-content: start;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .about-links a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
    transition: color var(--dur-fast) var(--ease);
  }

  .about-links a:hover {
    color: var(--accent);
  }

  .about-links .mono {
    color: var(--faint);
    font-size: 0.75rem;
  }

  @media (min-width: 900px) {
    .creed-inner {
      grid-template-columns: 160px minmax(0, 1fr) 300px;
      gap: clamp(24px, 3vw, 48px);
      align-items: start;
    }

    .creed-note {
      justify-self: end;
      padding-top: 6px;
    }
  }

  @media (min-width: 720px) {
    .facts-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }

  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(40px, 4vw, 56px);
    }

    .product {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(40px, 5vw, 72px);
    }

    .product--flip .product-window {
      order: 2;
    }

    .principles-grid {
      grid-template-columns: 0.72fr 1.28fr;
      gap: clamp(40px, 6vw, 96px);
    }

    .principles-head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }

    .about {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(48px, 6vw, 96px);
    }
  }
</style>
