---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProjectPreview from '../components/ProjectPreview.astro'
import { products } from '../data/products'
import { withBase } from '../lib/url'

const origin = Astro.site ?? new URL('https://lijuntong.github.io')
const homeUrl = new URL(withBase('/'), origin)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'JT 出品',
  alternateName: 'JT Works',
  url: homeUrl.href,
  description: 'JT 出品的桌面应用、软件项目和实验索引。',
  inLanguage: 'zh-CN',
  hasPart: products.map((product) => ({
    '@type': 'SoftwareApplication',
    name: product.name,
    applicationCategory: 'ProductivityApplication',
    operatingSystem: product.platforms.join(', '),
    url: new URL(withBase(`/${product.slug}/`), origin).href,
  })),
}

const principles = [
  {
    title: '数据留在本机',
    body: '待办、日程、邮件缓存写进本机的 SQLite 文件。没有云同步，也没有我们的服务器，因为根本没有服务器。',
  },
  {
    title: '不需要账号',
    body: '下载、安装、打开就能用。只有主动配置邮箱时，才需要填一次自己的 IMAP 信息。',
  },
  {
    title: '看得见的实现',
    body: '应用的源码在 GitHub 上，安装包、版本号和更新日志都在 Release 页面，改了什么都查得到。',
  },
]

const productCover = (slug: string) => {
  const product = products.find((item) => item.slug === slug)!
  return product.shots.find((shot) => shot.caption.includes('仪表盘')) ?? product.shots[0]
}

const projectCount = String(products.length).padStart(2, '0')
---

<BaseLayout
  title="JT 出品 · 自己做、自己用的软件索引"
  description="JT 出品：工作台、几件事，以及给 DeepSeek Harness 写的 Git 分支控件。界面、功能和下载入口都在这里。"
  jsonLd={jsonLd}
>
  <section class="index-hero" aria-labelledby="index-title">
    <div class="container index-layout">
      <aside class="studio">
        <div class="studio-copy">
          <h1 id="index-title">自己做的东西，<br />放在一个清楚的地方。</h1>
          <p class="studio-lead">
            两个本地优先的桌面应用。以后这里也会有 Web、移动端、开源库和实验，但入口始终清楚。
          </p>
        </div>

        <dl class="studio-facts">
          <div>
            <dt>当前项目</dt>
            <dd>{projectCount}</dd>
          </div>
          <div>
            <dt>当前形态</dt>
            <dd>桌面</dd>
          </div>
          <div>
            <dt>账户</dt>
            <dd>无</dd>
          </div>
        </dl>

        <div class="studio-actions">
          <a class="btn btn--primary" href="#projects">浏览项目</a>
          <a class="text-link" href="https://github.com/LijunTong" rel="noopener" target="_blank">
            GitHub
            <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </aside>

      <div id="projects" class="project-index">
        <header class="index-head">
          <div>
            <h2>项目索引</h2>
            <p>每个项目先给真实界面，再给类型、状态和入口。</p>
          </div>
          <span class="index-count mono">{projectCount} entries</span>
        </header>

        <div class="project-list">
          {products.map((product) => {
            const cover = productCover(product.slug)
            return (
              <article class="project-row" data-tone={product.tone}>
                <a class="preview-link" href={withBase(`/${product.slug}/`)} aria-label={`查看${product.name}`}>
                  <ProjectPreview
                    product={product}
                    cover={cover}
                    loading="eager"
                    sizes="(min-width: 1040px) 720px, 94vw"
                  />
                </a>

                <div class="project-copy">
                  <div class="project-meta">
                    <span class="tag tag--status">{product.statusLabel}</span>
                    <span class="tag">{product.kindLabel}</span>
                    <span class="project-year mono">{product.year}</span>
                  </div>

                  <div>
                    <h3>
                      <a href={withBase(`/${product.slug}/`)}>{product.name}</a>
                    </h3>
                    <p class="project-tagline">{product.tagline}</p>
                  </div>

                  <p class="project-summary">{product.summary}</p>

                  <ul class="project-points" aria-label={`${product.name}主要功能`}>
                    {product.features.slice(0, 3).map((feature) => (
                      <li>{feature.title}</li>
                    ))}
                  </ul>

                  <div class="project-footer">
                    <span class="project-platforms mono">{product.platforms.join(' / ')}</span>
                    <a class="project-link" href={withBase(`/${product.slug}/`)}>
                      打开项目
                      <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M4 8h8M9 5l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            )
          })}
        </div>
      </div>
    </div>
  </section>

  <section id="principles" class="section section--muted principles-section">
    <div class="container principles-grid">
      <header class="principles-head">
        <h2>为什么是这些工具</h2>
        <p>规模不大，边界清楚，能自己维护，也能每天用。</p>
      </header>

      <ol class="principles">
        {principles.map((item) => (
          <li class="principle">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="about" class="section about-section">
    <div class="container about">
      <div class="about-copy">
        <h2>一个人做的工具，<br />给自己每天用。</h2>
        <p>
          日常里反复出现的动作，被做成应用，装上就能用。更新优先发在 GitHub 的 Release 页面。
          这个索引会继续收录不同类型的项目，但只放真实在做、真实能用的东西。
        </p>
      </div>

      <ul class="about-links">
        <li>
          <a href={products[0].repo} rel="noopener" target="_blank">
            <span>工作台源码</span>
            <span class="mono">work-station</span>
          </a>
        </li>
        <li>
          <a href={products[1].repo} rel="noopener" target="_blank">
            <span>几件事源码</span>
            <span class="mono">Something</span>
          </a>
        </li>
        <li>
          <a href={products[2].repo} rel="noopener" target="_blank">
            <span>分支切换源码</span>
            <span class="mono">git-branch-tool</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/LijunTong" rel="noopener" target="_blank">
            <span>GitHub 主页</span>
            <span class="mono">@LijunTong</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .index-hero {
    padding-block: clamp(32px, 4vw, 56px) clamp(56px, 7vw, 88px);
  }

  .index-layout {
    display: grid;
    gap: 40px;
  }

  .studio {
    display: grid;
    align-content: start;
    gap: 28px;
  }

  .studio-copy {
    display: grid;
    gap: 20px;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(2.35rem, 3.3vw, 3.35rem);
    line-height: 1.08;
  }

  .studio-lead {
    max-width: 36ch;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.65;
  }

  .studio-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-block: 1px solid var(--border);
  }

  .studio-facts div {
    display: grid;
    gap: 3px;
    padding-block: 14px;
  }

  .studio-facts div + div {
    padding-inline-start: 14px;
    border-inline-start: 1px solid var(--border);
  }

  .studio-facts dt {
    color: var(--faint);
    font-size: 0.6875rem;
    line-height: 1.3;
  }

  .studio-facts dd {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .studio-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .project-index {
    min-width: 0;
  }

  .index-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    padding-block: 16px 22px;
    border-bottom: 1px solid var(--border-strong);
  }

  .index-head h2 {
    font-size: var(--step-2);
  }

  .index-head p {
    max-width: 44ch;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .index-count {
    flex: none;
    color: var(--faint);
    font-size: 0.75rem;
  }

  .project-list {
    display: grid;
  }

  .project-row {
    display: grid;
    gap: 28px;
    padding-block: 34px;
    border-bottom: 1px solid var(--border);
  }

  .preview-link {
    display: block;
    min-width: 0;
  }

  .preview-link :global(.preview) {
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur var(--ease)),
      transform var(--dur var(--ease));
  }

  .preview-link:hover :global(.preview) {
    border-color: var(--project-accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .project-copy {
    display: grid;
    align-content: start;
    gap: 18px;
    min-width: 0;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
  }

  .project-year {
    color: var(--faint);
    font-size: 0.75rem;
  }

  .project-copy h3 {
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.04;
  }

  .project-copy h3 a {
    transition: color var(--dur-fast) var(--ease);
  }

  .project-copy h3 a:hover {
    color: var(--project-accent);
  }

  .project-tagline {
    max-width: 26ch;
    margin-top: 8px;
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .project-summary {
    max-width: 54ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .project-points {
    display: grid;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .project-points li {
    padding-block: 9px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .project-points li::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-inline-end: 9px;
    border-radius: 1px;
    background: var(--project-accent);
    vertical-align: 2px;
  }

  .project-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 2px;
  }

  .project-platforms {
    color: var(--faint);
    font-size: 0.6875rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    color: var(--project-ink);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .project-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .principles-grid {
    display: grid;
    gap: 36px;
  }

  .principles-head {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .principles-head h2,
  .about h2 {
    font-size: var(--step-3);
  }

  .principles-head p {
    max-width: 32ch;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .principles {
    display: grid;
    border-top: 1px solid var(--border-strong);
    list-style: none;
  }

  .principle {
    display: grid;
    gap: 7px;
    padding-block: 22px;
    border-bottom: 1px solid var(--border);
  }

  .principle h3 {
    font-size: 1.0625rem;
  }

  .principle p {
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.9063rem;
    line-height: 1.7;
  }

  .about-section {
    border-top: 1px solid var(--border);
  }

  .about {
    display: grid;
    gap: 36px;
  }

  .about-copy {
    display: grid;
    gap: 18px;
    max-width: 58ch;
  }

  .about-copy p {
    color: var(--muted);
  }

  .about-links {
    display: grid;
    align-content: start;
    border-top: 1px solid var(--border-strong);
    list-style: none;
  }

  .about-links a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 15px;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    font-weight: 600;
    transition: color var(--dur-fast) var(--ease);
  }

  .about-links a:hover {
    color: var(--accent);
  }

  .about-links .mono {
    color: var(--faint);
    font-size: 0.75rem;
    font-weight: 400;
  }

  @media (min-width: 720px) {
    .principles-grid {
      grid-template-columns: 0.7fr 1.3fr;
      gap: 48px;
    }

    .about {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }

  @media (min-width: 1040px) {
    .index-layout {
      grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
      gap: clamp(32px, 4vw, 56px);
      align-items: start;
    }

    .studio {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      min-height: calc(100vh - var(--header-h) - 64px);
      padding-inline-end: clamp(24px, 3vw, 40px);
      border-inline-end: 1px solid var(--border);
    }

    .project-row {
      grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
      gap: clamp(24px, 3vw, 40px);
      align-items: start;
      padding-block: 40px;
    }

    .project-row:first-child {
      padding-top: 30px;
    }
  }

  @media (max-width: 520px) {
    .index-head {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
